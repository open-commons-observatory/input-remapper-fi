# Generated by `fi render` from fi.yaml. Do not edit by hand.
site_name: {{ vars.title | tojson }}
site_description: {{ vars.tagline | tojson }}
repo_url: https://github.com/{{ vars.repo }}
docs_dir: docs/generated
site_dir: _site
theme:
  name: material
nav:
  - Home: index.md
  - Coverage: coverage.md
  - Health: health.md
  - Triage: triage.md
  - Register: register.md
  - Provenance: provenance.md
markdown_extensions:
  - tables
  - pymdownx.superfences:
      custom_fences:
        - name: mermaid
          class: mermaid
          format: !!python/name:pymdownx.superfences.fence_code_format
